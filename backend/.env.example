GROQ_API_KEY=
GROQ_MODEL_ORCHESTRATOR=openai/gpt-oss-120b
GROQ_MODEL_SPECIALIST=openai/gpt-oss-20b
SIM_SEED=42
# Morning briefing to Telegram (optional): create a bot with @BotFather, send it a message, then put its token and your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BRIEFING_AT=07:00
BRIEFING_LANG=ar
# Problem alerts to Telegram (same bot and chat as the briefing): a message with every detail when a problem opens, grows or is resolved, and for early warnings.
# ALERTS_ENABLED=1            set 0 to stop them (for example while running the stress scripts)
# ALERTS_MIN_SEVERITY=warning info | warning | critical
# ALERTS_LANG=ar              en | ar (default: BRIEFING_LANG)
# ALERTS_WARNINGS=1           also send early warnings
# ALERTS_PER_HOUR=30          more than this in an hour are held back, with one notice
# ALERTS_WAIT_FINDING_S=45    seconds to wait for the agent's finding before sending what the detector knows
# APP_URL=http://localhost:5173   adds a link to the incident
